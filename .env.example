APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
TRUST_PROXY=false

# Required for production jobs and distributed rate limiting
REDIS_URL=redis://redis:6379/0

# Required for production artifact delivery
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=aaron-toolkit
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniosecret

# Required when APP_ENV=production
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

ARTIFACT_TTL_SECONDS=900
JOB_TTL_SECONDS=3600
MAX_MEDIA_DURATION_SECONDS=1800
MAX_MEDIA_BYTES=524288000
MEDIA_TIMEOUT_SECONDS=900
MEDIA_JOBS_PER_HOUR=3
TIKTOK_JOBS_PER_HOUR=3
QR_REQUESTS_PER_MINUTE=30
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
IMAGE_CONVERSIONS_PER_MINUTE=10
MAX_PDF_BYTES=26214400
MAX_PDF_PAGES=100
PDF_TIMEOUT_SECONDS=180
PDF_JOBS_PER_HOUR=3
PDF_MAX_CONCURRENCY=1
PDF_MEMORY_LIMIT_MB=1024
WORKER_CONCURRENCY=2
